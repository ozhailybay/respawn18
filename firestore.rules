rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for validation
    function isValidEmail(email) {
      return email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }
    
    function isValidUserData(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.uid is string &&
             data.email is string &&
             isValidEmail(data.email) &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             data.role in ['school', 'business', 'admin', 'student'];
    }
    
    function isValidPostData(data) {
      return data.keys().hasAll(['title', 'description', 'authorId', 'createdAt']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             data.description is string &&
             data.description.size() > 0 &&
             data.description.size() <= 5000 &&
             data.authorId is string &&
             data.createdAt is timestamp;
    }
    
    function isValidJobData(data) {
      return data.keys().hasAll(['title', 'description', 'companyName', 'location', 'employmentType', 'experienceLevel', 'salary']) &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             data.description is string &&
             data.description.size() > 0 &&
             data.description.size() <= 5000 &&
             data.companyName is string &&
             data.companyName.size() > 0 &&
             data.companyName.size() <= 100 &&
             data.location is string &&
             data.location.size() > 0 &&
             data.location.size() <= 100 &&
             data.employmentType in ['Полная занятость', 'Частичная занятость', 'Проектная работа', 'Стажировка'] &&
             data.experienceLevel in ['Без опыта', 'Начальный уровень', 'Средний уровень', 'Продвинутый уровень'] &&
             data.salary is string &&
             data.salary.size() > 0 &&
             data.salary.size() <= 100;
    }
    
    // Public read-only content (posts, jobs, etc.)
    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId &&
        isValidPostData(request.resource.data);
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.authorId &&
        isValidPostData(request.resource.data);
    }
    
    // Jobs - ПОЛНОСТЬЮ ПУБЛИЧНЫЕ для чтения, авторизованные для записи
    match /jobs/{jobId} {
      allow read: if true; // Любой может читать вакансии
      allow create, update, delete: if request.auth != null &&
        isValidJobData(request.resource.data);
    }
    
    // Chats - для авторизованных пользователей
    match /chats/{chatId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Chat messages - для авторизованных пользователей
    match /chats/{chatId}/messages/{messageId} {
      allow read, write, create: if request.auth != null;
    }
    
    // AI Chat messages - для авторизованных пользователей
    match /aiChats/{chatId} {
      allow read, write, create: if request.auth != null;
    }
    
    // AI Chat messages - для авторизованных пользователей
    match /aiChats/{chatId}/messages/{messageId} {
      allow read, write, create: if request.auth != null;
    }
    
    // User profiles - публичное чтение, владелец может редактировать
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == userId;
      allow update: if request.auth != null && 
        request.auth.uid == userId;
      allow delete: if request.auth != null && 
        request.auth.uid == userId;
    }
    
    // User private data - только владелец
    match /users/{userId}/private/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Applications - пользователь может читать/писать свои заявки
    match /applications/{applicationId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Resumes - пользователь может читать/писать свои резюме
    match /resumes/{resumeId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Notifications - пользователь может читать/писать свои уведомления
    match /notifications/{notificationId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Micro-internships - публичное чтение, авторизованная подача заявок
    match /microInternships/{internshipId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 2000;
    }
    
    // Micro-applications - пользователь может читать/писать свои заявки
    match /microApplications/{applicationId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Resume analyses - только владелец
    match /resumeAnalyses/{analysisId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Dashboard data - для авторизованных пользователей
    match /dashboard/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Networking profiles - публичное чтение, владелец может редактировать
    match /networkingProfiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.auth.uid == profileId;
      allow update: if request.auth != null && 
        request.auth.uid == profileId;
      allow delete: if request.auth != null && 
        request.auth.uid == profileId;
    }
    
    // Projects - публичное чтение, авторизованные для создания
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    // Project applications - пользователь может читать/писать свои заявки
    match /projectApplications/{applicationId} {
      allow read, write, create: if request.auth != null;
    }
    
    // Fallback - deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
