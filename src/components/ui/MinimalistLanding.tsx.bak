import React, { useState, useEffect, useRef, useCallback } from 'react';
import { Link } from 'react-router-dom';
import { motion } from 'framer-motion';

// Импортируем созданные компоненты
import GradientText from './GradientText';
import TypewriterText from './TypewriterText';
import AnimatedIcon from './AnimatedIcon';
import FeatureCard from './FeatureCard';
import Testimonial from './Testimonial';

// Компонент для анимированных частиц
const FloatingParticles = () => {
  return (
    <div className="absolute inset-0 overflow-hidden pointer-events-none">
      {Array.from({ length: 20 }).map((_, i) => (
        <motion.div
          key={i}
          className="absolute w-2 h-2 rounded-full bg-blue-500/20 dark:bg-blue-400/20"
          style={{
            top: `${Math.random() * 100}%`,
            left: `${Math.random() * 100}%`,
          }}
          animate={{
            y: [0, Math.random() * -100 - 50],
            x: [0, (Math.random() - 0.5) * 50],
            opacity: [0, 0.7, 0],
            scale: [0, Math.random() + 0.5, 0],
          }}
          transition={{
            duration: Math.random() * 5 + 5,
            repeat: Infinity,
            delay: Math.random() * 5,
            ease: "easeInOut",
          }}
        />
      ))}
    </div>
  );
};

const MinimalistLanding = () => {
  const heroRef = useRef<HTMLDivElement>(null);
  const [mousePosition, setMousePosition] = useState({ x: 0, y: 0 });
  const [isMobile, setIsMobile] = useState(false);
  const [scrollY, setScrollY] = useState(0);
  
  // Проверка мобильного устройства
  useEffect(() => {
    const checkMobile = () => {
      setIsMobile(window.innerWidth < 768);
    };
    
    checkMobile();
    window.addEventListener("resize", checkMobile);
    return () => window.removeEventListener("resize", checkMobile);
  }, []);
  
  // Эффект для отслеживания мыши
  useEffect(() => {
    if (isMobile) return;
    
    const handleMouseMove = (e: MouseEvent) => {
      if (!heroRef.current) return;
      
      const rect = heroRef.current.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      setMousePosition({ x, y });
    };
    
    window.addEventListener("mousemove", handleMouseMove);
    return () => window.removeEventListener("mousemove", handleMouseMove);
  }, [isMobile]);

  // Эффект для отслеживания скролла
  useEffect(() => {
    const handleScroll = () => {
      setScrollY(window.scrollY);
    };
    
    window.addEventListener("scroll", handleScroll);
    return () => window.removeEventListener("scroll", handleScroll);
  }, []);

  // Аналитика для отслеживания кликов по CTA
  const trackCTAClick = useCallback(() => {
    if (typeof window !== 'undefined' && 'gtag' in window) {
      // @ts-ignore
      window.gtag('event', 'cta_click', { label: 'first_task' });
    }
  }, []);
  
  return (
    <div className="min-h-screen bg-white dark:bg-slate-900 overflow-hidden relative">
      {/* Минималистичные геометрические элементы */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        {/* Горизонтальные линии */}
        <div className="absolute top-1/4 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-200 dark:via-blue-800 to-transparent"></div>
        <div className="absolute top-2/4 left-0 right-0 h-px bg-gradient-to-r from-transparent via-indigo-200 dark:via-indigo-800 to-transparent"></div>
        <div className="absolute top-3/4 left-0 right-0 h-px bg-gradient-to-r from-transparent via-purple-200 dark:via-purple-800 to-transparent"></div>
        
        {/* Вертикальные линии */}
        <div className="absolute top-0 bottom-0 left-1/4 w-px bg-gradient-to-b from-transparent via-blue-200 dark:via-blue-800 to-transparent"></div>
        <div className="absolute top-0 bottom-0 left-2/4 w-px bg-gradient-to-b from-transparent via-indigo-200 dark:via-indigo-800 to-transparent"></div>
        <div className="absolute top-0 bottom-0 left-3/4 w-px bg-gradient-to-b from-transparent via-purple-200 dark:via-purple-800 to-transparent"></div>
        
        {/* Акцентные геометрические формы */}
        <motion.div 
          className="absolute top-20 left-20 w-64 h-64 border border-blue-200 dark:border-blue-800 rounded-full opacity-20"
          animate={{
            scale: [1, 1.1, 1],
            opacity: [0.2, 0.3, 0.2],
          }}
          transition={{
            duration: 8,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        />
        <motion.div 
          className="absolute bottom-20 right-20 w-96 h-96 border border-indigo-200 dark:border-indigo-800 rounded-full opacity-20"
          animate={{
            scale: [1, 1.15, 1],
            opacity: [0.2, 0.25, 0.2],
          }}
          transition={{
            duration: 10,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        />
        
        {/* Минималистичные цветовые акценты */}
        <motion.div 
          className="absolute top-1/3 right-1/4 w-16 h-16 bg-blue-500/5 rounded-full blur-xl"
          animate={{
            y: [-10, 10, -10],
            x: [5, -5, 5],
          }}
          transition={{
            duration: 5,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        />
        <motion.div 
          className="absolute bottom-1/3 left-1/4 w-24 h-24 bg-indigo-500/5 rounded-full blur-xl"
          animate={{
            y: [10, -10, 10],
            x: [-5, 5, -5],
          }}
          transition={{
            duration: 7,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        />
        
        {/* Уникальные геометрические элементы */}
        <motion.div 
          className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"
          animate={{
            rotate: [0, 45, 0, -45, 0],
          }}
          transition={{
            duration: 20,
            repeat: Infinity,
            ease: "easeInOut"
          }}
        >
          <div className="w-32 h-32 border-2 border-indigo-200/20 dark:border-indigo-800/20 rotate-45 transform-gpu"></div>
        </motion.div>
        
        <motion.div 
          className="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-blue-50/30 dark:from-blue-900/5 to-transparent"
          style={{
            y: scrollY * 0.2
          }}
        />
        
        {/* Анимированные частицы */}
        <FloatingParticles />
      </div>
      
      <div className="container mx-auto px-4 sm:px-6 relative z-10 py-20">
        {/* Hero секция */}
        <div className="max-w-5xl mx-auto mb-20" ref={heroRef}>
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 0.6 }}
            className="flex flex-col lg:flex-row items-center"
          >
            {/* Левая колонка с текстом */}
            <div className="lg:w-1/2 lg:pr-10 mb-10 lg:mb-0">
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ duration: 0.6, delay: 0.1 }}
              >
                <motion.h1 
                  className="text-5xl sm:text-6xl font-extrabold mb-6 leading-tight"
                  initial={{ opacity: 0, y: 30 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ duration: 0.8 }}
                >
                  <motion.span 
                    className="text-slate-800 dark:text-white font-normal mb-2 block"
                    initial={{ opacity: 0, x: -20 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ duration: 0.6, delay: 0.2 }}
                  >Нет опыта?</motion.span>
                  <motion.div
                    initial={{ scale: 0.9, opacity: 0 }}
                    animate={{ scale: 1, opacity: 1 }}
                    transition={{ duration: 0.8, delay: 0.4 }}
                    className="relative"
                  >
                    <GradientText className="text-4xl sm:text-5xl font-extrabold block">
                      <TypewriterText 
                        text="Превращаем навыки в деньги" 
                        delay={300}
                        speed={50}
                      />
                    </GradientText>
                    <motion.div
                      className="absolute -bottom-2 left-0 h-1 bg-gradient-to-r from-blue-500 to-indigo-600 rounded-full"
                      initial={{ width: 0 }}
                      animate={{ width: "100%" }}
                      transition={{ duration: 1, delay: 1.5 }}
                    />
                  </motion.div>
                  <motion.span 
                    className="text-slate-800 dark:text-white block mt-4 text-3xl sm:text-4xl"
                    initial={{ opacity: 0, x: 20 }}
                    animate={{ opacity: 1, x: 0 }}
                    transition={{ duration: 0.6, delay: 0.6 }}
                  >
                    Даже если кейсов ноль
                  </motion.span>
                </motion.h1>
                
                <motion.div 
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ duration: 0.6, delay: 0.2 }}
                  className="text-xl leading-relaxed text-slate-600 dark:text-slate-300 mb-10"
                >
                  <motion.span 
                    className="inline-flex items-center px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-900/30 text-blue-800 dark:text-blue-200 text-sm font-medium mr-2"
                    whileHover={{ scale: 1.05 }}
                    whileTap={{ scale: 0.95 }}
                  >
                    <svg className="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Оплата ≤ 48 часов
                  </motion.span>
                  
                  <motion.span 
                    className="inline-flex items-center px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-900/30 text-indigo-800 dark:text-indigo-200 text-sm font-medium"
                    whileHover={{ scale: 1.05 }}
                    whileTap={{ scale: 0.95 }}
                  >
                    <svg className="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Безопасная сделка
                  </motion.span>
                  
                  <motion.div 
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ duration: 0.6, delay: 0.3 }}
                    className="mt-8 flex flex-wrap gap-4"
                  >
                    <motion.div
                      whileHover={{ scale: 1.05 }}
                      whileTap={{ scale: 0.95 }}
                    >
                      <Link 
                        to="/signup" 
                        onClick={trackCTAClick}
                        className="inline-flex items-center justify-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-lg shadow-blue-500/20 hover:shadow-blue-500/40 transition-all duration-300"
                      >
                        <span className="relative z-10">Начать бесплатно</span>
                        <motion.svg 
                          className="ml-2 w-5 h-5" 
                          fill="none" 
                          stroke="currentColor" 
                          viewBox="0 0 24 24"
                          animate={{ x: [0, 4, 0] }}
                          transition={{ duration: 1.5, repeat: Infinity, repeatType: "loop", ease: "easeInOut" }}
                        >
                          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </motion.svg>
                      </Link>
                    </motion.div>
                    
                    <motion.div
                      whileHover={{ scale: 1.05 }}
                      whileTap={{ scale: 0.95 }}
                    >
                      <Link 
                        to="/how-it-works"
                        className="inline-flex items-center justify-center px-6 py-3 border border-gray-300 dark:border-gray-700 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-sm transition-all duration-300"
                      >
                        Как это работает
                      </Link>
                    </motion.div>
                  </motion.div>
                </motion.div>
              </div>
            </div>
            
            {/* Правая колонка с иллюстрацией */}
            <motion.div 
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.3 }}
              className="lg:w-1/2 relative"
              style={{
                transform: !isMobile ? `perspective(1000px) rotateY(${mousePosition.x * 5}deg) rotateX(${-mousePosition.y * 5}deg)` : 'none',
                transition: 'transform 0.2s ease-out'
              }}
            >
              <div className="relative">
                <motion.div 
                  className="absolute -top-4 -left-4 w-24 h-24 bg-blue-500/10 dark:bg-blue-500/20 rounded-lg transform rotate-6"
                  animate={{ 
                    rotate: [6, 12, 6],
                    scale: [1, 1.05, 1],
                  }}
                  transition={{ duration: 8, repeat: Infinity, ease: "easeInOut" }}
                />
                <motion.div 
                  className="absolute -bottom-4 -right-4 w-32 h-32 bg-indigo-500/10 dark:bg-indigo-500/20 rounded-lg transform -rotate-6"
                  animate={{ 
                    rotate: [-6, -12, -6],
                    scale: [1, 1.05, 1],
                  }}
                  transition={{ duration: 10, repeat: Infinity, ease: "easeInOut" }}
                />
                
                <motion.div 
                  className="relative bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700"
                  whileHover={{ y: -5 }}
                  transition={{ duration: 0.3 }}
                >
                  <div className="p-6">
                    <div className="flex items-center justify-between mb-6">
                      <div className="flex items-center">
                        <motion.div 
                          className="w-10 h-10 rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold"
                          whileHover={{ scale: 1.1 }}
                          transition={{ duration: 0.3 }}
                        >J</motion.div>
                        <div className="ml-3">
                          <h3 className="font-semibold text-gray-900 dark:text-white">JumysAL</h3>
                          <p className="text-sm text-gray-500 dark:text-gray-400">Работа для студентов</p>
                        </div>
                      </div>
                      <div className="flex space-x-1">
                        <div className="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600"></div>
                        <div className="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600"></div>
                        <div className="w-2 h-2 rounded-full bg-gray-300 dark:bg-gray-600"></div>
                      </div>
                    </div>
                    
                    <div className="space-y-4">
                      <motion.div 
                        className="bg-gray-100 dark:bg-gray-700 rounded-lg p-4"
                        whileHover={{ y: -3, scale: 1.02 }}
                        transition={{ duration: 0.2 }}
                      >
                        <div className="flex justify-between items-center mb-2">
                          <h4 className="font-medium text-gray-900 dark:text-white">Дизайн лендинга</h4>
                          <span className="text-sm font-medium text-green-600 dark:text-green-400">₸15,000</span>
                        </div>
                        <p className="text-sm text-gray-500 dark:text-gray-400">Создание современного дизайна для стартапа</p>
                        <div className="mt-3 flex items-center">
                          <span className="text-xs bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 px-2 py-1 rounded">Дизайн</span>
                          <span className="ml-2 text-xs bg-purple-100 dark:bg-purple-900/40 text-purple-800 dark:text-purple-300 px-2 py-1 rounded">Figma</span>
                          <span className="ml-auto text-xs text-gray-500 dark:text-gray-400">2 дня</span>
                        </div>
                      </motion.div>
                      
                      <motion.div 
                        className="bg-gray-100 dark:bg-gray-700 rounded-lg p-4"
                        whileHover={{ y: -3, scale: 1.02 }}
                        transition={{ duration: 0.2 }}
                      >
                        <div className="flex justify-between items-center mb-2">
                          <h4 className="font-medium text-gray-900 dark:text-white">Верстка сайта</h4>
                          <span className="text-sm font-medium text-green-600 dark:text-green-400">₸20,000</span>
                        </div>
                        <p className="text-sm text-gray-500 dark:text-gray-400">Адаптивная верстка для интернет-магазина</p>
                        <div className="mt-3 flex items-center">
                          <span className="text-xs bg-indigo-100 dark:bg-indigo-900/40 text-indigo-800 dark:text-indigo-300 px-2 py-1 rounded">Frontend</span>
                          <span className="ml-2 text-xs bg-yellow-100 dark:bg-yellow-900/40 text-yellow-800 dark:text-yellow-300 px-2 py-1 rounded">React</span>
                          <span className="ml-auto text-xs text-gray-500 dark:text-gray-400">3 дня</span>
                        </div>
                      </motion.div>
                    </div>
                    
                    <div className="mt-6 pt-4 border-t border-gray-200 dark:border-gray-700">
                      <div className="flex justify-between items-center">
                        <span className="text-sm font-medium text-gray-500 dark:text-gray-400">Всего заданий</span>
                        <motion.span 
                          className="font-medium text-gray-900 dark:text-white"
                          animate={{ scale: [1, 1.1, 1] }}
                          transition={{ duration: 2, repeat: Infinity, repeatDelay: 5 }}
                        >42</motion.span>
                      </div>
                      <div className="mt-2 flex justify-between items-center">
                        <span className="text-sm font-medium text-gray-500 dark:text-gray-400">Средний бюджет</span>
                        <motion.span 
                          className="font-medium text-gray-900 dark:text-white"
